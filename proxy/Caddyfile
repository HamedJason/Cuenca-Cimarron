# HTTPS con certificados automáticos de Let's Encrypt.
# Solo se pide certificado para el dominio que aprueba la API (el de DOMINIO en .env o el del panel de administración).
{
	on_demand_tls {
		ask http://backend:8000/api/tls/permitir
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy frontend:80
}

http:// {
	reverse_proxy frontend:80
}
